{
  "options": {
    "candidateStart": 0,
    "candidateEnd": 20,
    "hookSceneDuration": 0,
    "suppressionEnd": 0,
    "maxCharsPerLine": 16,
    "maxLines": 2,
    "minSubtitleDuration": 1.1,
    "maxSubtitleDuration": 4.2,
    "minGapBetweenSubtitles": 0.08
  },
  "cases": [
    {
      "name": "short text leaves silence empty",
      "segments": [
        {
          "text": "短い字幕です",
          "start": 0,
          "end": 12
        }
      ],
      "expected": [
        {
          "start": 0,
          "end": 4.2,
          "text": "短い字幕です"
        }
      ]
    },
    {
      "name": "short text uses speech envelope",
      "segments": [
        {
          "text": "短い字幕です",
          "start": 0,
          "end": 12,
          "words": [
            {
              "start": 1.25,
              "end": 2.1,
              "word": "短い字幕です"
            }
          ]
        }
      ],
      "expected": [
        {
          "start": 1.25,
          "end": 2.1,
          "text": "短い字幕です"
        }
      ]
    },
    {
      "name": "slow short speech stays one caption",
      "segments": [
        {
          "text": "引き延ばした言葉",
          "start": 0,
          "end": 12,
          "words": [
            {
              "start": 0.5,
              "end": 8,
              "word": "引き延ばした言葉"
            }
          ]
        }
      ],
      "expected": [
        {
          "start": 0.5,
          "end": 8,
          "text": "引き延ばした言葉"
        }
      ]
    },
    {
      "name": "timed phrases split at punctuation and preserve silence",
      "segments": [
        {
          "text": "今日はお菓子を作ります。そしてみんなで食べます。",
          "start": 0,
          "end": 12,
          "words": [
            {
              "start": 0.4,
              "end": 0.9,
              "word": "今日は"
            },
            {
              "start": 1,
              "end": 1.4,
              "word": "お菓子を"
            },
            {
              "start": 1.6,
              "end": 2.1,
              "word": "作ります。"
            },
            {
              "start": 4,
              "end": 4.4,
              "word": "そして"
            },
            {
              "start": 4.5,
              "end": 5,
              "word": "みんなで"
            },
            {
              "start": 5.1,
              "end": 5.8,
              "word": "食べます。"
            }
          ]
        }
      ],
      "expected": [
        {
          "start": 0.4,
          "end": 2.1,
          "text": "今日はお菓子を作ります。"
        },
        {
          "start": 4,
          "end": 5.8,
          "text": "そしてみんなで食べます。"
        }
      ],
      "options": {
        "maxCharsPerLine": 6,
        "maxLines": 2
      }
    },
    {
      "name": "word boundaries and six character minimum",
      "segments": [
        {
          "text": "今日はお菓子を作ります。そしてみんなで食べます。",
          "start": 0,
          "end": 12,
          "words": [
            {
              "start": 0.4,
              "end": 0.9,
              "word": "今日は"
            },
            {
              "start": 1,
              "end": 1.4,
              "word": "お菓子を"
            },
            {
              "start": 1.6,
              "end": 2.1,
              "word": "作ります。"
            },
            {
              "start": 4,
              "end": 4.4,
              "word": "そして"
            },
            {
              "start": 4.5,
              "end": 5,
              "word": "みんなで"
