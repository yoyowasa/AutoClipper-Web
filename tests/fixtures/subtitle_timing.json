      "expected": [
        {
          "start": 0,
          "end": 12,
          "text": "今日はお菓子を作ります。そしてみんなで食べます。"
        }
      ],
      "options": {
        "maxCharsPerLine": 8,
        "maxLines": 1
      }
    },
    {
      "name": "legacy proportional long text",
      "segments": [
        {
          "text": "あいうえおかきくけこさしすせそたちつてと",
          "start": 0,
          "end": 10
        }
      ],
      "expected": [
        {
          "start": 0,
          "end": 6,
          "text": "あいうえおかきくけこさし"
        },
        {
          "start": 6,
          "end": 10,
          "text": "すせそたちつてと"
        }
      ],
      "options": {
        "maxCharsPerLine": 6,
        "maxLines": 2
      }
    },
    {
      "name": "half millisecond rounding agrees across runtimes",
      "segments": [
        {
          "start": 0,
          "end": 3,
          "text": "半秒ではない",
          "words": [
            {
              "start": 0.0625,
              "end": 1.0625,
              "word": "半秒ではない"
            }
          ]
        }
      ],
      "expected": [
        {
          "start": 0.063,
          "end": 1.063,
          "text": "半秒ではない"
        }
      ]
    },
    {
      "name": "zero duration punctuation stays attached",
      "segments": [
        {
          "start": 0,
          "end": 2,
          "text": "字幕の末尾。",
          "words": [
            {
              "start": 0.5,
              "end": 1.5,
              "word": "字幕の末尾"
            },
            {
              "start": 1.5,
              "end": 1.5,
              "word": "。"
            }
          ]
        }
      ],
      "expected": [
        {
          "start": 0.5,
          "end": 1.5,
          "text": "字幕の末尾。"
        }
      ]
    },
    {
      "name": "timed manual one line keeps words together",
      "options": {
        "maxCharsPerLine": 6,
        "maxLines": 1
      },
      "segments": [
        {
          "start": 0,
          "end": 8,
          "text": "長めの字幕を一行にします",
          "singleLine": true,
          "preserveSegmentation": true,
          "words": [
            {
              "start": 1,
              "end": 2,
              "word": "長めの字幕を"
