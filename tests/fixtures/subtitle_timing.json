          ]
        }
      ],
      "expected": [
        {
          "start": 1,
          "end": 4,
          "text": "長めの字幕を一行にします"
        }
      ]
    },
    {
      "name": "no speech inside clip produces no caption",
      "options": {
        "candidateStart": 5,
        "candidateEnd": 10
      },
      "segments": [
        {
          "start": 0,
          "end": 12,
          "text": "先の発話です",
          "words": [
