      "segments": [
        {
          "text": "今日はお菓子を作ります。そしてみんなで食べます。",
          "start": 0,
          "end": 12,
          "words": [
            {
              "start": 0.4,
              "end": 0.9,
              "word": "今日は"
            },
            {
              "start": 1,
              "end": 1.4,
              "word": "お菓子を"
            },
            {
              "start": 1.6,
              "end": 2.1,
              "word": "作ります。"
            },
            {
              "start": 4,
              "end": 4.4,
              "word": "そして"
            },
            {
              "start": 4.5,
              "end": 5,
              "word": "みんなで"
            },
            {
              "start": 5.1,
              "end": 5.8,
              "word": "食べます。"
