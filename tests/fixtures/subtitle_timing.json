        {
          "start": 3,
          "end": 4.3,
          "text": "みんなで食べます。"
        }
      ],
      "options": {
        "candidateStart": 1.5,
        "candidateEnd": 6,
        "maxCharsPerLine": 6,
        "maxLines": 2
      }
    },
    {
      "name": "hook shifts and suppresses timed subtitle",
      "segments": [
        {
          "text": "短い字幕です",
          "start": 0,
          "end": 12,
          "words": [
            {
              "start": 1,
              "end": 2,
              "word": "短い字幕です"
            }
          ]
        }
      ],
      "expected": [
        {
          "start": 3.5,
          "end": 4,
          "text": "短い字幕です"
        }
      ],
      "options": {
        "hookSceneDuration": 2,
        "suppressionEnd": 3.5
      }
    },
    {
      "name": "manual boundary long text stays intact",
      "segments": [
        {
          "text": "今日はお菓子を作ります。そしてみんなで食べます。",
          "start": 0,
          "end": 12,
          "preserveSegmentation": true,
          "singleLine": true
