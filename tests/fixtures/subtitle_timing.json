    {
      "name": "whitespace normalized speech tokens",
      "segments": [
        {
          "start": 0,
          "end": 8,
          "text": "hello world",
          "words": [
            {
              "start": 1,
              "end": 1.5,
              "word": "hello"
            },
            {
              "start": 3,
              "end": 4,
              "word": " world"
            }
          ]
        }
